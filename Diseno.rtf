<!-- Alpine.js for State Management -->\
<script defer="" src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>\
<script>\
        function setupState() \{\
            return \{\
                showAddModal: false,\
                newTeamName: '',\
                selectedLocalTeam: 'Cumbres',\
                teams: [],\
                \
                init() \{\
                    const savedTeams = localStorage.getItem('jdm_local_teams');\
                    if (savedTeams) \{\
                        this.teams = JSON.parse(savedTeams);\
                    \} else \{\
                        // Default teams\
                        this.teams = [\
                            \{ id: 1, name: 'Cumbres' \},\
                            \{ id: 2, name: 'Club T\'e1chira' \}\
                        ];\
                        this.saveTeams();\
                    \}\
                \},\
\
                saveTeams() \{\
                    localStorage.setItem('jdm_local_teams', JSON.stringify(this.teams));\
                \},\
\
                addTeam() \{\
                    if (this.newTeamName.trim() === '') return;\
                    \
                    const newTeam = \{\
                        id: Date.now(),\
                        name: this.newTeamName.trim()\
                    \};\
                    \
                    this.teams.push(newTeam);\
                    this.newTeamName = '';\
                    this.saveTeams();\
                \},\
\
                removeTeam(id) \{\
                    const teamToRemove = this.teams.find(t => t.id === id);\
                    if (teamToRemove && this.selectedLocalTeam === teamToRemove.name) \{\
                        this.selectedLocalTeam = '';\
                    \}\
                    this.teams = this.teams.filter(t => t.id !== id);\
                    this.saveTeams();\
                \}\
            \}\
        \}\
    </script>\
</body></html>}